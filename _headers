# Response headers for the deployed site. Read by Workers static assets at
# deploy time; the file itself is never served.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# Named by content, not by date: a new cut of either face lands under a new
# filename, so the old URL can never go stale.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
