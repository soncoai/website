{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "sonco-website",
	"compatibility_date": "2026-09-08",

	// Assets are served first; the script handles POST /contact and hands
	// everything else back to ASSETS, so the 404 page still applies.
	"main": "worker.mjs",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	},

	// Email Routing on this zone: no provider, no API key. The recipient is
	// the CONTACT_TO secret (see README).
	"send_email": [
		{ "name": "CONTACT" }
	],

	// Apex only: www redirects here via a Cloudflare rule, to avoid duplicate
	// content (see README).
	"routes": [
		{ "pattern": "sonco.ai", "custom_domain": true }
	]
}
